
#!/usr/bin/env bash
set -euo pipefail

echo "Creating Docker SSH + GHCR Codespace..."

mkdir -p .devcontainer

# ----------------------------------
# DEVCONTAINER CONFIGURATION
# ----------------------------------

cat > .devcontainer/devcontainer.json <<'EOF'
{
  "name": "Ubuntu DinD SSH GHCR",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true
    }
  },
  "forwardPorts": [8080, 3000, 8000],
  "remoteEnv": {
    "DOCKER_BUILDKIT": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "remoteUser": "vscode"
}
EOF

# ----------------------------------
# DOCKERFILE
# ----------------------------------

cat > Dockerfile <<'EOF'
# syntax=docker/dockerfile:1.7

FROM mcr.microsoft.com/devcontainers/base:ubuntu

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    openssh-client \
    git \
    curl \
    wget \
    ca-certificates \
    gnupg \
    jq \
    nano \
    vim \
    unzip \
    zip \
    iproute2 \
    iputils-ping \
    dnsutils \
    net-tools \
    python3 \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# SSH agent forwarding example.
# Private keys are not copied into the image.

RUN mkdir -p /workspace

WORKDIR /workspace

# Example BuildKit SSH mount:
#
# RUN --mount=type=ssh \
#     git clone git@github.com:OWNER/PRIVATE_REPO.git
#
# Supply SSH forwarding with:
# docker build --ssh default .
EOF

# ----------------------------------
# POST-CREATE SCRIPT
# ----------------------------------

cat > .devcontainer/post-create.sh <<'EOF'
#!/usr/bin/env bash
set -e

sudo apt-get update

sudo apt-get install -y \
    openssh-client \
    git \
    curl \
    jq \
    nano \
    vim \
    ca-certificates

echo "Checking Docker..."

docker --version
docker compose version
docker buildx version

echo "Docker environment installed."
EOF

chmod +x .devcontainer/post-create.sh

# ----------------------------------
# DOCKER COMPOSE
# ----------------------------------

cat > docker-compose.yml <<'EOF'
services:
  nginx:
    image: nginx:alpine
    ports:
      - "8080:80"
    restart: unless-stopped
EOF

# ----------------------------------
# GITIGNORE
# ----------------------------------

cat > .gitignore <<'EOF'
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
.ssh/
EOF

echo ""
echo "================================="
echo " Docker SSH + GHCR setup created"
echo "================================="
echo ""
echo "Next:"
echo "1. Rebuild your Codespace."
echo "2. Configure SSH authentication."
echo "3. Authenticate to GHCR."
